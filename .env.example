# Copy this file to .env and fill in the required values locally.
# Never commit .env or real credentials.

# LiveKit Cloud runtime configuration for Q1. Obtain these from your LiveKit
# project; do not commit a populated .env file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=darwix-candidate-screening

# The default Q1 agent uses LiveKit Cloud inference for STT, LLM, and TTS.
# No separate model-provider key is required for that configuration.
